# Copier en .env.local et remplir. Ne JAMAIS committer de vraies valeurs.
# Aucune de ces variables n'a le préfixe NEXT_PUBLIC_ : elles restent côté serveur.

# Phase 2 — Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Seule la clé anonyme pourra être exposée au navigateur (protégée par RLS) :
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Intégrations futures (serveur uniquement)
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Clé de chiffrement des jetons OAuth stockés en base (32 octets, base64)
TOKEN_ENCRYPTION_KEY=
